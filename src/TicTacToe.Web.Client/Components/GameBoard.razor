<div class="game-board" role="group" aria-label="Game board" aria-busy="@IsBusy">
    @foreach (var space in Board)
    {
        <button type="button"
                class="@GetSpaceCssClass(space)"
                aria-label="@GetAccessibleLabel(space)"
                disabled="@IsSpaceDisabled(space)"
                @onclick="() => SelectSpaceAsync(space.Index)">
            <span aria-hidden="true">@GetDisplayValue(space)</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BoardSpace> Board { get; set; } = [];

    [Parameter]
    public bool IsInteractive { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public IReadOnlyList<int>? WinningLine { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<int> OnSpaceSelected { get; set; }

    private string GetAccessibleLabel(BoardSpace space)
    {
        var value = space.Mark?.ToString() ?? "empty";
        return $"Space {space.Index + 1}, {value}";
    }

    private static string GetDisplayValue(BoardSpace space)
    {
        return space.Mark?.ToString() ?? string.Empty;
    }

    private string GetSpaceCssClass(BoardSpace space)
    {
        var classes = new List<string> { "game-board__space" };

        if (space.Mark is not null)
        {
            classes.Add("game-board__space--filled");
        }

        if (WinningLine?.Contains(space.Index) is true)
        {
            classes.Add("game-board__space--winning");
        }

        return string.Join(" ", classes);
    }

    private bool IsSpaceDisabled(BoardSpace space)
    {
        return IsBusy || !IsInteractive || space.Mark is not null;
    }

    private Task SelectSpaceAsync(int boardIndex)
    {
        if (IsBusy || !IsInteractive)
        {
            return Task.CompletedTask;
        }

        return OnSpaceSelected.InvokeAsync(boardIndex);
    }
}