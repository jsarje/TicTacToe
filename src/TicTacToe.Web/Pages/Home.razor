@page "/"

<PageTitle>Tic-Tac-Toe</PageTitle>

<div class="home-shell">
	<header class="home-shell__header">
		<p class="home-shell__eyebrow">Local Match</p>
		<h1>Tic-Tac-Toe</h1>
		<p class="home-shell__summary">A fast two-player board with clear status updates and one-tap restart.</p>
	</header>

	<ErrorBoundary>
		<ChildContent>
			<section class="game-panel" aria-label="Tic-tac-toe game screen">
				<GameStatus Message="@Session.StatusMessage" />
				<GameBoard Board="@Session.Board"
						   IsInteractive="@Session.IsBoardInteractive"
						   WinningLine="@Session.WinningLine"
						   OnSpaceSelected="HandleSpaceSelectionAsync" />
				<RestartButton OnRestart="RestartGameAsync" />
			</section>
		</ChildContent>
		<ErrorContent Context="_">
			<section class="game-panel game-panel--error" role="alert">
				<h2>Board unavailable</h2>
				<p>Refresh to reset the match.</p>
			</section>
		</ErrorContent>
	</ErrorBoundary>
</div>
